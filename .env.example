# Senha do painel /admin (mínimo 12 caracteres). OBRIGATÓRIA para habilitar o painel.
ADMIN_PASSWORD=
# Segredo para assinar a sessão do admin (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Número do WhatsApp da BBM Imports, só dígitos com DDI+DDD (ex.: 5511999999999).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# URL pública do site (usada em canonical, sitemap e Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tamanho máximo de upload de modelo 3D, em MB.
MAX_MODEL_MB=25
